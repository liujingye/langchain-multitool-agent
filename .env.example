# 任意 OpenAI 兼容服务，例如：
#   OpenAI:   OPENAI_BASE_URL 留空, MODEL_NAME=gpt-4o-mini
#   DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1, MODEL_NAME=deepseek-chat
#   通义千问: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, MODEL_NAME=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# 可选：配置后使用 Tavily 网页搜索（https://tavily.com），否则降级为 Wikipedia 搜索
TAVILY_API_KEY=
